# Outbound n8n polling (default production mode)
GB_BRIDGE_N8N_BASE_URL=http://homeassistant.tailde272c.ts.net:5678
GB_BRIDGE_N8N_WEBHOOK_PREFIX=/webhook/playtest
GB_BRIDGE_N8N_HEADER_NAME=X-GB-Bridge-Key
GB_BRIDGE_N8N_HEADER_VALUE=

GB_BRIDGE_POLL_INTERVAL_SEC=5
GB_BRIDGE_HEARTBEAT_INTERVAL_SEC=30
GB_BRIDGE_LEASE_DURATION_SEC=120
GB_BRIDGE_WORKER_ID=

# Local state (%USERPROFILE%\.gb-bridge on Windows)
GB_BRIDGE_STATE_DIR=
GB_BRIDGE_REPO_ROOT=C:\path\to\Dices-and-Devices

# Holdout guard (must match n8n/job payload approval when using rids 55-59)
GB_BRIDGE_HOLDOUT_APPROVAL_ID=

# Timeouts
GB_BRIDGE_JOB_TIMEOUT_SEC=14400
GB_BRIDGE_GAME_TIMEOUT_SEC=900
GB_BRIDGE_REQUEST_TIMEOUT_SEC=45

# Antigravity investigate_defect (disabled by default)
GB_BRIDGE_ANTIGRAVITY_ENABLED=0
GB_BRIDGE_ANTIGRAVITY_WINDOW_LIMIT=5
GB_BRIDGE_ANTIGRAVITY_WINDOW_HOURS=5
# Optional daily cap (0 = disabled; quota resets on rolling window instead)
# GB_BRIDGE_ANTIGRAVITY_DAILY_LIMIT=20
GB_BRIDGE_ANTIGRAVITY_WEEKLY_LIMIT=80
# Default: %LOCALAPPDATA%\agy\bin\agy.exe on Windows (override if agy is elsewhere)
GB_BRIDGE_ANTIGRAVITY_CLI=
# Shared JSONL ledger (calls + usage.total_tokens); holme example:
# GB_BRIDGE_ANTIGRAVITY_LEDGER_PATH=/workspace/bot-lab/antigravity-ledger.jsonl
GB_BRIDGE_ANTIGRAVITY_LEDGER_PATH=
# Legacy alias for LEDGER_PATH
GB_BRIDGE_ANTIGRAVITY_QUOTA_PATH=
# Prepended to investigate_defect prompts (direct answer; no plan artifacts)
# GB_BRIDGE_ANTIGRAVITY_DIRECT_ANSWER_PREAMBLE=
GB_BRIDGE_ANTIGRAVITY_OUTPUT_FORMAT=json
GB_BRIDGE_ANTIGRAVITY_MODE=plan
GB_BRIDGE_ANTIGRAVITY_PRINT_TIMEOUT_SEC=600
# GB_BRIDGE_ANTIGRAVITY_MODEL=
# GB_BRIDGE_ANTIGRAVITY_SANDBOX=
# GB_BRIDGE_ANTIGRAVITY_JSON_SCHEMA=
# Extra agy flags (never pass --dangerously-skip-permissions)
# GB_BRIDGE_ANTIGRAVITY_EXTRA_ARGS=

# Defer playtest claims when Ollama has loaded models on the shared GPU
GB_BRIDGE_OLLAMA_DEFER_ENABLED=1
GB_BRIDGE_OLLAMA_PS_URL=http://127.0.0.1:11434/api/ps
GB_BRIDGE_OLLAMA_DEFER_BACKOFF_SEC=60
# Set 1 to defer when /api/ps is unreachable (default: proceed)
GB_BRIDGE_OLLAMA_DEFER_ON_CHECK_ERROR=0

# Optional localhost HTTP shim (OFF by default — no inbound on laptop)
GB_BRIDGE_HTTP_SERVER_ENABLED=0
GB_BRIDGE_BIND_HOST=127.0.0.1
GB_BRIDGE_BIND_PORT=8787
GB_BRIDGE_BEARER_TOKEN=